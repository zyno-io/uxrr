{
    "name": "uxrr",
    "version": "0.1.2",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.md",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn workspaces foreach -At run build",
        "build:client": "yarn workspace @zyno-io/uxrr-client build",
        "build:api": "yarn workspace @zyno-io/uxrr-api build",
        "build:ui": "yarn workspace @zyno-io/uxrr-ui build",
        "dev:api": "yarn workspace @zyno-io/uxrr-api dev",
        "dev:ui": "yarn workspace @zyno-io/uxrr-ui dev",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "migrate": "yarn workspace @zyno-io/uxrr-api migrate",
        "test": "yarn workspace @zyno-io/uxrr-api test",
        "test:e2e": "scripts/test-e2e.sh",
        "test:e2e:vrt": "scripts/test-e2e.sh vrt",
        "test:e2e:live": "scripts/test-e2e.sh live",
        "clean": "yarn workspaces foreach -A run clean",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt"
    },
    "devDependencies": {
        "lefthook": "^2.1.16",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "typescript": "^7.0.2",
        "vitepress": "^1.6.4"
    },
    "resolutions": {
        "@rrweb/packer": "2.1.7",
        "@rrweb/replay": "2.1.7",
        "@rrweb/rrweb-plugin-console-record": "2.1.7",
        "@rrweb/types": "2.1.7",
        "@rrweb/utils": "2.1.7",
        "@vitejs/plugin-vue": "6.0.9",
        "esbuild": "0.28.2",
        "js-yaml": "4.3.2",
        "rrdom": "2.1.7",
        "rrweb": "2.1.7",
        "rrweb-snapshot": "2.1.7",
        "typescript@~7.0.2": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
        "vitepress/vite": "7.3.6"
    },
    "packageManager": "yarn@4.18.1"
}
